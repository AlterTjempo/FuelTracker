# Credentials:
TANKERKONIG_API_KEY=your-api-key-here


# Set your desired location and range (in km).
LATITUDE=51.800483
LONGITUDE=6.138107
RANGE=10

# CORS Allowed Origins (comma-separated, or use "*" for all origins)
# For development: http://localhost:5173,http://localhost:3000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# JWT Secret (change in production!)
JWT_SECRET_KEY=change-me-to-a-random-string

# reCAPTCHA v2 (optional - leave empty to disable bot protection)
RECAPTCHA_SECRET_KEY=

# Vite key:
VITE_RECAPTCHA_SITE_KEY=
# Public API docs (/docs, /openapi.json). Keep false in production.
ENABLE_DOCS=false

# Send visitor IPs to ipapi.co to fill the admin traffic map (privacy: disclose it). Off by default.
ENABLE_IP_GEOLOCATION=false

# --- Optional: put these in a file named `.env` next to docker-compose.yml (NOT config.env) ---
# Which address the database (5432) and the API (8000) listen on on the host.
# Default 127.0.0.1 = only this machine. 0.0.0.0 = reachable from the network: then use a strong
# database password and a firewall rule that only allows your own IP.
# DB_BIND=0.0.0.0
# API_BIND=127.0.0.1

# Credentials:
TANKERKONIG_API_KEY=your-api-key-here

# Optional: EIA API key for Brent crude prices.
OIL_PRICE_API_KEY=

# Set your desired location and range (in km).
LATITUDE=51.800483
LONGITUDE=6.138107
RANGE=10

# CORS Allowed Origins (comma-separated, or use "*" for all origins)
# For development: http://localhost:5173,http://localhost:3000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# JWT Secret (change in production!)
JWT_SECRET_KEY=change-me-to-a-random-string

# reCAPTCHA v2 (optional - leave empty to disable bot protection)
RECAPTCHA_SECRET_KEY=

# Vite key:
VITE_RECAPTCHA_SITE_KEY=